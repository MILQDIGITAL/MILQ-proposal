# Base URL of the Parking Lingo API (no trailing slash). Leave empty to use demo mode only.
# On a physical iPhone use your computer's LAN IP, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_API_URL=
# Optional shared token, sent as the `x-app-token` header.
EXPO_PUBLIC_APP_TOKEN=
EXPO_PUBLIC_MOCK_FIXTURE=
EXPO_PUBLIC_MOCK_DEMO_TIME=
