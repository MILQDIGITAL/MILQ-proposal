# --- Required in live mode -------------------------------------------------
# Anthropic API key (server-side only; never ship it in the app).
ANTHROPIC_API_KEY=

# --- Vision model ------------------------------------------------------------
# Model used to read signs (default claude-opus-5-5).
PARKING_LINGO_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (default medium). Lower = faster/cheaper, higher = more careful.
PARKING_LINGO_EFFORT=medium
# Retry on another model if the request is declined by safety classifiers (default 1).
PARKING_LINGO_REFUSAL_FALLBACK=1

# --- Demo / development -----------------------------------------------------
# 1 = serve fixtures from @parking-lingo/core/fixtures, no API key needed.
MOCK_VISION=0

# --- Server -------------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Shared app token; when set, /v1/* requires header `x-app-token: <value>`.
PARKING_LINGO_APP_TOKEN=
# Set to 1 behind a proxy/load balancer (Fly, Render, Railway) so per-IP limits use X-Forwarded-For.
TRUST_PROXY=0
# Comma-separated allowed origins for browsers ('*' for any). Empty = no CORS headers (native app doesn't need them).
CORS_ORIGINS=
LOG_REQUESTS=1

# --- Limits -------------------------------------------------------------------
# Max decoded image size in bytes (default and maximum: 5 MB, Claude's per-image limit).
MAX_IMAGE_BYTES=5242880
# MAX_BODY_BYTES defaults to the base64 size of MAX_IMAGE_BYTES + 64 KB.
# Overall deadline for one /v1/read-sign call, ms.
READ_TIMEOUT_MS=60000
# SDK retries for upstream 429/5xx/connection errors (within the deadline).
UPSTREAM_MAX_RETRIES=1
# Per-IP requests per window (0 disables).
RATE_LIMIT_READ_SIGN=20
RATE_LIMIT_EVALUATE=120
RATE_LIMIT_WINDOW_MS=60000
